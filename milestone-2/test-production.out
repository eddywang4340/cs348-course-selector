-- Feature R7: Fetch prerequisites & anti-requisites of a course
--------------

Query OK, 0 rows affected (0.000 sec)

--------------
-- Includes BEFORE vs. AFTER optimization pair for symmetric anti-requisite lookup.
--------------

Query OK, 0 rows affected (0.000 sec)

--------------
-- ============================================================
--------------

Query OK, 0 rows affected (0.000 sec)

--------------
SET @subject = 'CS', @catalog_number = '246'
--------------

Query OK, 0 rows affected (0.000 sec)

--------------
-- 1. Prerequisites Query
--------------

Query OK, 0 rows affected (0.000 sec)

--------------
SELECT p.prereq_course_id AS course_id, c.subject, c.catalog_number, c.title
FROM Course c0
JOIN Prereq p ON p.course_id = c0.course_id
JOIN Course c ON c.course_id = p.prereq_course_id
WHERE c0.subject = @subject
  AND c0.catalog_number = @catalog_number
--------------

+-----------+---------+----------------+--------------------------------------------------+
| course_id | subject | catalog_number | title                                            |
+-----------+---------+----------------+--------------------------------------------------+
|         2 | CS      | 136            | Elementary Algorithm Design and Data Abstraction |
|         3 | CS      | 245            | Logic and Computation                            |
+-----------+---------+----------------+--------------------------------------------------+
2 rows in set (0.001 sec)

--------------
EXPLAIN
SELECT p.prereq_course_id AS course_id, c.subject, c.catalog_number, c.title
FROM Course c0
JOIN Prereq p ON p.course_id = c0.course_id
JOIN Course c ON c.course_id = p.prereq_course_id
WHERE c0.subject = @subject
  AND c0.catalog_number = @catalog_number
--------------

+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| EXPLAIN                                                                                                                                                                                                                                    |
+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| -> Nested loop inner join  (cost=1.15 rows=2)
    -> Covering index lookup on p using PRIMARY (course_id = '4')  (cost=0.45 rows=2)
    -> Single-row index lookup on c using PRIMARY (course_id = p.prereq_course_id)  (cost=0.3 rows=1)
 |
+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
1 row in set, 1 warning (0.000 sec)

--------------
-- 2. Anti-requisites Query: BEFORE Optimization
--------------

Query OK, 0 rows affected (0.000 sec)

--------------
SELECT c.course_id, c.subject, c.catalog_number, c.title
FROM Course c0
JOIN Antireq a ON c0.course_id IN (a.course_id, a.antireq_course_id)
JOIN Course c ON c.course_id IN (a.course_id, a.antireq_course_id)
  AND c.course_id != c0.course_id
WHERE c0.subject = @subject
  AND c0.catalog_number = @catalog_number
--------------

+-----------+---------+----------------+-------------------------------------------------+
| course_id | subject | catalog_number | title                                           |
+-----------+---------+----------------+-------------------------------------------------+
|        11 | CS      | 246E           | Object-Oriented Software Development (Enriched) |
|     11419 | CS      | 247            | Software Engineering Principles                 |
|     17299 | SYDE    | 322            | Software Design                                 |
|     18831 | MSE     | 342            | Principles of Software Engineering              |
+-----------+---------+----------------+-------------------------------------------------+
4 rows in set (0.001 sec)

--------------
EXPLAIN
SELECT c.course_id, c.subject, c.catalog_number, c.title
FROM Course c0
JOIN Antireq a ON c0.course_id IN (a.course_id, a.antireq_course_id)
JOIN Course c ON c.course_id IN (a.course_id, a.antireq_course_id)
  AND c.course_id != c0.course_id
WHERE c0.subject = @subject
  AND c0.catalog_number = @catalog_number
--------------

+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| EXPLAIN                                                                                                                                                                                                                                                                                                                                                                                                                              |
+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| -> Nested loop inner join  (cost=617267 rows=6.17e+6)
    -> Filter: ('4' in (a.course_id,a.antireq_course_id))  (cost=138 rows=1371)
        -> Covering index scan on a using antireq_course_id  (cost=138 rows=1371)
    -> Filter: ((c.course_id in (a.course_id,a.antireq_course_id)) and (c.course_id <> '4'))  (cost=1.99 rows=4501)
        -> Index range scan on c (re-planned for each iteration)  (cost=1.99 rows=4501)
 |
+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
1 row in set, 1 warning (0.000 sec)

