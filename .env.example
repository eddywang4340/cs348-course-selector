# Copy this file to .env (in the repo root) and adjust as needed:
#   cp .env.example .env
#
# .env is git-ignored; this file is tracked so teammates know which
# variables scripts/setup-db.sh understands. Every value below is
# optional -- the script falls back to the defaults shown here, and will
# prompt for a password interactively if the server needs one and
# MYSQL_PASSWORD is left blank.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
SAMPLE_DB=cs348_sample
PRODUCTION_DB=cs348_production
